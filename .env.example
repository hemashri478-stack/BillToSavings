# Bill-to-Savings — Environment Variables Configuration
# Copy this file to `.env` if running the optional Node.js backend (`node server/server.js`).
# Note: The application runs 100% in Demo Mode and Manual Entry Mode WITHOUT any API keys.

# Optional: Server Port (defaults to 3000)
PORT=3000

# Optional: External Vision/LLM API Key for automated OCR bill extraction
# Never expose these keys in frontend browser code!
# Bill data is never sent to external AI services without explicit user consent.
GEMINI_API_KEY=
OPENAI_API_KEY=
